{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/telemetry-tracker.csproj"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "run-workspace",
            "type": "process",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/Invoke-AgentWorkspace.ps1",
                "-Command",
                "run"
            ],
            "problemMatcher": []
        },
        {
            "label": "test-workspace",
            "type": "process",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/Invoke-AgentWorkspace.ps1",
                "-Command",
                "test",
                "-ProjectPath",
                "${workspaceFolder}/telemetry-tracker.Tests/telemetry-tracker.Tests.csproj"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
